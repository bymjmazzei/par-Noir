# Copy to .env and fill in. Do not commit .env.

# PostgreSQL (required when API uses database features; see api/README.md)
# DATABASE_URL=

# OAuth JWT signing (required in production)
# PN_OAUTH_SECRET=

# Opaque mailbox route owner hashing (required; no soft default)
# MAILBOX_ROUTE_PEPPER=

# Optional: 32-byte key for AES-256-GCM encryption of feed_tokens synthetic fields (hex 64 chars or base32-byte base64).
# If unset, a key is derived from PN_OAUTH_SECRET (same process must use same secret).
# FEED_TOKEN_ENCRYPTION_KEY=

# Optional: Redis — response cache; when connected, API-key rate limits are shared across instances (see docs/api/RATE_LIMITS.md)
# REDIS_URL=redis://localhost:6379

# Optional: comma-separated client IPs that skip HTTP rate limiters (dev/QA). Does not bypass Google quota.
# RATE_LIMIT_BYPASS_IPS=203.0.113.10,203.0.113.11

# Optional: Sentry error reporting (API only; strips Authorization / cookies in beforeSend)
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0

# Optional: JSON access logs to stdout (one line per request; path only, no query string). Default on in development only.
# ACCESS_LOG_JSON=true

# Optional: require valid OAuth Bearer token for Socket.IO connections (handshake auth.token or Authorization)
# SOCKET_REQUIRE_AUTH=true

# Creator fund — Stripe monetization maintenance (omit until configured; checkout/portal/webhooks return 503)
# Setup: cd api && STRIPE_SECRET_KEY=sk_test_... node scripts/stripe-bootstrap.mjs  (prints the lines below)
# Check what is set (presence only): GET /api/monetization/readiness with the admin API key
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_CONNECT_WEBHOOK_SECRET=
# STRIPE_MONETIZATION_PRICE_ID=price_...
# Optional: fixed renewal cents when Price cannot be read (balance-first math)
# STRIPE_MONETIZATION_RENEWAL_CENTS=1000

# Identity verification — Veriff (included in membership; omit until configured and the dashboard shows "not configured")
# Veriff Customer Portal → Integrations: API key + shared secret; set the decision webhook URL to
#   https://api.parnoir.com/api/verification/veriff/webhook
# VERIFF_API_KEY=
# VERIFF_SHARED_SECRET=
# Per billed session (approved / declined / resubmission), recorded once as creator-fund opex (E)
# VERIFF_COST_CENTS=
# HMAC key for document number + country: one document can verify only one pN
# VERIFICATION_DEDUPE_SECRET=
# HMAC key for verified legal names (required in production)
# LEGAL_NAME_HMAC_KEY=

# Creator fund period close (no Stripe): rolling window length in days; cron secret for POST /api/creator-fund/periods/close
# CREATOR_FUND_PERIOD_DAYS=30
# For local testing only you may use CREATOR_FUND_PERIOD_DAYS=1 so a window elapses quickly.
# Also used by .github/workflows/creator-fund-cron.yml (repo secret) for daily close + payouts
# CREATOR_FUND_CRON_SECRET=
# Optional: HMAC-SHA256(chain_hash) stored on each closed period row (bridge until cloud KMS; keep secret off logs)
# CREATOR_FUND_PERIOD_ATTESTATION_SECRET=
# Optional: GCP Cloud KMS key version resource name (same shape as PN_OAUTH_KMS_KEY_VERSION) to asymmetricSign period digest
# CREATOR_FUND_PERIOD_KMS_KEY_VERSION=projects/PROJECT/locations/REGION/keyRings/RING/cryptoKeys/KEY/cryptoKeyVersions/1
# Days after period close before bounty allocations become payable (default 45)
# CREATOR_FUND_PAYOUT_HOLD_DAYS=45

# Content-free push (locked pNs). /api/push/vapid-public-key returns 503 until VAPID keys are set.
# Generate once: npx web-push generate-vapid-keys  (keep the private key in your secret store only)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:support@parnoir.com
# Native push via FCM (pN Unlock app): path to the Firebase service account JSON
# GOOGLE_APPLICATION_CREDENTIALS=
