# Copy to .env and fill in. Do not commit .env.

# OAuth JWT signing (required in production)
# PN_OAUTH_SECRET=

# Optional: 32-byte key for AES-256-GCM encryption of feed_tokens synthetic fields (hex 64 chars or base32-byte base64).
# If unset, a key is derived from PN_OAUTH_SECRET (same process must use same secret).
# FEED_TOKEN_ENCRYPTION_KEY=
