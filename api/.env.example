# Copy to .env and fill in. Do not commit .env.

# PostgreSQL (required when API uses database features; see api/README.md)
# DATABASE_URL=

# OAuth JWT signing (required in production)
# PN_OAUTH_SECRET=

# Optional: 32-byte key for AES-256-GCM encryption of feed_tokens synthetic fields (hex 64 chars or base32-byte base64).
# If unset, a key is derived from PN_OAUTH_SECRET (same process must use same secret).
# FEED_TOKEN_ENCRYPTION_KEY=

# Optional: Redis — response cache; when connected, API-key rate limits are shared across instances (see docs/api/RATE_LIMITS.md)
# REDIS_URL=redis://localhost:6379

# Optional: Sentry error reporting (API only; strips Authorization / cookies in beforeSend)
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0

# Optional: JSON access logs to stdout (one line per request; path only, no query string). Default on in development only.
# ACCESS_LOG_JSON=true

# Optional: require valid OAuth Bearer token for Socket.IO connections (handshake auth.token or Authorization)
# SOCKET_REQUIRE_AUTH=true

# Creator fund — Stripe monetization maintenance (omit until configured; checkout/portal/webhooks return 503)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_MONETIZATION_PRICE_ID=price_...
# Optional: fixed renewal cents when Price cannot be read (balance-first math)
# STRIPE_MONETIZATION_RENEWAL_CENTS=999

# Creator fund period close (no Stripe): rolling window length in days; cron secret for POST /api/creator-fund/periods/close
# CREATOR_FUND_PERIOD_DAYS=30
# For local testing only you may use CREATOR_FUND_PERIOD_DAYS=1 so a window elapses quickly.
# CREATOR_FUND_CRON_SECRET=
# Optional: HMAC-SHA256(chain_hash) stored on each closed period row (bridge until cloud KMS; keep secret off logs)
# CREATOR_FUND_PERIOD_ATTESTATION_SECRET=
# Days after period close before bounty allocations become payable (default 45)
# CREATOR_FUND_PAYOUT_HOLD_DAYS=45
