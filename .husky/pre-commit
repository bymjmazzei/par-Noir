#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"
# Block commits that add known secret patterns (API keys, client IDs, etc.)
if [ -f scripts/check-secrets.sh ]; then
  bash scripts/check-secrets.sh || { echo "❌ check-secrets.sh: possible secret in staged changes. Do not commit .env, API keys, or secrets."; exit 1; }
fi

if [ -f scripts/check-quantum-imports.sh ]; then
  bash scripts/check-quantum-imports.sh || { echo "❌ check-quantum-imports: do not import quarantined identity-core quantum path from apps/sdk/oauth-ui."; exit 1; }
fi

if [ -f scripts/check-no-backup-files.sh ]; then
  bash scripts/check-no-backup-files.sh || { echo "❌ check-no-backup-files: delete *.backup/*.bak before committing."; exit 1; }
fi

if [ -f scripts/check-app-import-boundary.sh ]; then
  bash scripts/check-app-import-boundary.sh || { echo "❌ check-app-import-boundary: apps must not import each other; use packages/core/sdk."; exit 1; }
fi

if [ -f scripts/check-token-resolver-boundary.sh ]; then
  bash scripts/check-token-resolver-boundary.sh || { echo "❌ check-token-resolver-boundary: resolve Drive tokens via resolveOwnerDriveToken (ownerDriveToken.ts)."; exit 1; }
fi

if [ -f scripts/check-drive-token-freshness-boundary.sh ]; then
  bash scripts/check-drive-token-freshness-boundary.sh || { echo "❌ check-drive-token-freshness-boundary: decide Drive token freshness in @par-noir/device-cloud-credentials, never from a stored expires_in."; exit 1; }
fi

echo "🔒 Running security audit before commit..."

# Run security audit
npm run security:audit

# If security audit fails, prevent commit
if [ $? -ne 0 ]; then
  echo "❌ Security audit failed. Please fix security issues before committing."
  exit 1
fi

echo "✅ Security audit passed. Proceeding with commit..."
