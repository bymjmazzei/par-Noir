#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"
# Block commits that add known secret patterns (API keys, client IDs, etc.)
if [ -f scripts/check-secrets.sh ]; then
  bash scripts/check-secrets.sh || { echo "❌ check-secrets.sh: possible secret in staged changes. Do not commit .env, API keys, or secrets."; exit 1; }
fi


echo "🔒 Running security audit before commit..."

# Run security audit
npm run security:audit

# If security audit fails, prevent commit
if [ $? -ne 0 ]; then
  echo "❌ Security audit failed. Please fix security issues before committing."
  exit 1
fi

echo "✅ Security audit passed. Proceeding with commit..."
