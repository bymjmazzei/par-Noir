{
  "name": "par-noir-desktop",
  "version": "1.0.0",
  "description": "Par Noir desktop shell that embeds the production cloud storage experience.",
  "productName": "par Noir Desktop",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "build": "npm run build:renderer && npm run build:main && npm run build:preload && npm run bundle:veracrypt && node scripts/post-build.js",
    "build:renderer": "vite build --config vite.config.ts",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "tsc -p tsconfig.preload.json",
    "dist": "npm run build && electron-builder --mac",
    "dist:dir": "npm run build && electron-builder --mac --dir",
    "dist:win": "npm run build && electron-builder --win --dir",
    "dist:linux": "npm run build && electron-builder --linux --dir",
    "dist:all": "npm run build && electron-builder --mac --win --linux --dir",
    "bundle:veracrypt": "node scripts/bundle-veracrypt.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "keytar": "^7.9.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.0.3",
    "autoprefixer": "^10.4.14",
    "electron": "29.3.0",
    "electron-builder": "^24.13.1",
    "postcss": "^8.4.27",
    "tailwindcss": "^3.3.0",
    "typescript": "^5.4.5",
    "vite": "^5.2.11"
  },
  "build": {
    "appId": "com.parnoir.desktop",
    "directories": {
      "buildResources": "build"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icons/icon.icns",
      "target": [
        "dmg"
      ]
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "node_modules/**",
      "package.json",
      "resources/veracrypt/**"
    ],
    "extraResources": [
      {
        "from": "resources/veracrypt",
        "to": "veracrypt",
        "filter": ["**/*"]
      }
    ]
  }
}
