{
  "name": "par-noir-pen-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "par Noir Pen desktop (Mac / Windows)",
  "productName": "par Noir Pen",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "build:pen": "npm run build --prefix ../pen",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "tsc -p tsconfig.preload.json",
    "build": "npm run build:pen && npm run build:main && npm run build:preload",
    "dist:mac": "npm run build && electron-builder --mac --dir",
    "dist:win": "npm run build && electron-builder --win --dir",
    "lint": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.preload.json --noEmit"
  },
  "dependencies": {
    "@par-noir/desktop-ipc": "file:../../packages/desktop-ipc",
    "@par-noir/desktop-secure-volume": "file:../../packages/desktop-secure-volume"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "electron": "29.3.0",
    "electron-builder": "^24.13.1",
    "typescript": "^5.4.5"
  },
  "build": {
    "appId": "com.parnoir.pen",
    "productName": "par Noir Pen",
    "npmRebuild": false,
    "directories": {
      "buildResources": "build"
    },
    "protocols": [
      {
        "name": "par Noir Pen",
        "schemes": ["com.parnoir.pen"]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": ["dmg", "dir"]
    },
    "win": {
      "target": ["portable", "dir"]
    },
    "files": [
      "dist-electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../pen/dist",
        "to": "pen-web"
      }
    ]
  }
}
