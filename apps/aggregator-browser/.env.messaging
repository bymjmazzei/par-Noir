# Loaded by: vite build --mode messaging
# Ensures dist-messaging + import.meta.env.VITE_DEFAULT_VIEW === 'messaging'
VITE_DEFAULT_VIEW=messaging
# Hide feed/search/upload nav; keep messaging + profile (Me)
VITE_MESSAGING_ONLY=true
# Separate OAuth client so messaging gets its own grant and never asks for age proofs
VITE_PN_CLIENT_ID=messaging-app
