# pN OAuth – required for unlock/sign-in popup
# Use "browser-app" (the registered client ID for the par Noir browser app).
# Copy to .env before building: cp env.template .env
VITE_PN_CLIENT_ID=browser-app

# API — optional; if unset, src/config/api.ts defaults to https://api.parnoir.com
# VITE_API_ENDPOINT=https://api.parnoir.com

# Decentralized coordination (optional; default true)
# VITE_USE_DECENTRALIZED=true
