{
  "name": "par-noir-aggregator-browser",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run sync:vault-script && vite",
    "sync:vault-script": "node scripts/sync-vault-script.mjs",
    "build": "npm run sync:vault-script && vite build",
    "build:messaging": "npm run sync:vault-script && vite build --mode messaging",
    "type-check": "tsc --noEmit",
    "test:unit": "vitest run",
    "build:mobile": "npm run build && npx cap sync",
    "build:mobile:messaging": "npm run build:messaging && cd capacitor-messaging && npx cap sync",
    "open:android": "npx cap open android",
    "open:ios": "npx cap open ios",
    "preview": "vite preview",
    "build:e2e": "VITE_API_ENDPOINT=\"${VITE_API_ENDPOINT:-https://api.parnoir.com}\" npm run build",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "npm run build:e2e && playwright test --project=chromium",
    "test:e2e:smoke:prebuilt": "playwright test --project=chromium"
  },
  "dependencies": {
    "@capacitor/app": "^6.0.0",
    "@capacitor/browser": "^6.0.0",
    "@capacitor/camera": "^6.0.0",
    "@capacitor/clipboard": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/keyboard": "^6.0.0",
    "@capacitor/push-notifications": "^6.0.0",
    "@capacitor/share": "^6.0.0",
    "@capacitor/splash-screen": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0",
    "@par-noir/aggregator-domain": "file:../../packages/aggregator-domain",
    "@par-noir/device-client": "file:../../packages/device-client",
    "@par-noir/device-cloud-credentials": "file:../../packages/device-cloud-credentials",
    "@par-noir/dm-crypto": "file:../../packages/dm-crypto",
    "@par-noir/identity-migration": "file:../../packages/identity-migration",
    "@par-noir/messaging-ui": "file:../../packages/messaging-ui",
    "@par-noir/oauth-ui": "file:../../packages/oauth-ui",
    "@par-noir/standard-data-points": "file:../../packages/standard-data-points",
    "@par-noir/user-owned-storage": "file:../../packages/user-owned-storage",
    "@sentry/react": "^8.55.0",
    "@types/dompurify": "^3.0.5",
    "capacitor-secure-storage-plugin": "^0.10.0",
    "dompurify": "^3.3.0",
    "jspdf": "^3.0.4",
    "lucide-react": "^0.263.1",
    "pdfjs-dist": "^5.4.394",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/cli": "^6.0.0",
    "@capacitor/ios": "^6.0.0",
    "@playwright/test": "^1.54.2",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^7.1.2",
    "vitest": "^3.2.4"
  }
}
