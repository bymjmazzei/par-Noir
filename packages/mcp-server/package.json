{
  "name": "@par-noir/mcp-server",
  "version": "0.1.0",
  "description": "par Noir MCP tools: the local pn-mcp CLI and the tool core the API's remote /mcp endpoint serves",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "pn-mcp": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "node ./scripts/prepare.js",
    "start": "tsx src/cli.ts serve",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@napi-rs/keyring": "^2.1.2",
    "@par-noir/dm-crypto": "file:../dm-crypto",
    "@par-noir/pen-protocol": "file:../pen-protocol",
    "@par-noir/standard-data-points": "file:../standard-data-points",
    "tsx": "^4.23.15",
    "zod": "^3.25.76"
  }
}
