{
  "name": "@par-noir/user-owned-storage",
  "version": "0.1.0",
  "description": "User-owned blob and table storage abstractions for multi-cloud pN layout",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./pn-layout": {
      "types": "./dist/pnLayout.d.ts",
      "import": "./dist/pnLayout.js",
      "default": "./dist/pnLayout.js"
    },
    "./sqlite": {
      "types": "./dist/sqlite.d.ts",
      "import": "./dist/sqlite.js",
      "require": "./dist/sqlite.js",
      "default": "./dist/sqlite.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "sql.js": "^1.16.0"
  },
  "devDependencies": {
    "@types/sql.js": "^1.4.11",
    "typescript": "^5.0.0",
    "vitest": "^3.2.4"
  }
}
