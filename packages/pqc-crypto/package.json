{
  "name": "@par-noir/pqc-crypto",
  "version": "0.1.0",
  "description": "PQC primitives for par Noir identity (ML-DSA-65, ML-KEM-768) and wire helpers",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./encoding": {
      "types": "./dist/encoding.d.ts",
      "import": "./dist/encoding.js",
      "require": "./dist/encoding.js"
    },
    "./ml-dsa": {
      "types": "./dist/mlDsa.d.ts",
      "import": "./dist/mlDsa.js",
      "require": "./dist/mlDsa.js"
    },
    "./constants": {
      "types": "./dist/constants.d.ts",
      "import": "./dist/constants.js",
      "require": "./dist/constants.js"
    },
    "./oauth-unlock-proof": {
      "types": "./dist/oauthUnlockProof.d.ts",
      "import": "./dist/oauthUnlockProof.js",
      "require": "./dist/oauthUnlockProof.js"
    }
  },

  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:oauth-unlock-script",
    "build:oauth-unlock-script": "esbuild src/oauthUnlockProofBrowser.ts --bundle --format=iife --target=es2017 --outfile=../../api/src/static/oauth/oauth-unlock-proof.js --banner:js=\"/* GENERATED from packages/pqc-crypto/src/oauthUnlockProofBrowser.ts by build:oauth-unlock-script. Do not edit by hand. */\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@noble/hashes": "^2.0.0",
    "@noble/post-quantum": "^0.5.4",
    "cborg": "^4.2.8"
  },
  "devDependencies": {
    "esbuild": "^0.25.9",
    "typescript": "^5.0.0",
    "vitest": "^3.2.4"
  },
  "license": "UNLICENSED",
  "private": true
}
