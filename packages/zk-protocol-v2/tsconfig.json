{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@par-noir/pqc-crypto/constants": ["../pqc-crypto/dist/constants"],
      "@par-noir/pqc-crypto/encoding": ["../pqc-crypto/dist/encoding"],
      "@par-noir/pqc-crypto/ml-dsa": ["../pqc-crypto/dist/mlDsa"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts"]
}
