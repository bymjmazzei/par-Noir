    "./web": {
      "types": "./src/web/index.ts",
      "default": "./src/web/index.ts"
    }
  },
  "files": ["dist", "src/web", "SPEC.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@noble/hashes": "^2.0.0",
    "@par-noir/pen-protocol": "file:../pen-protocol",
