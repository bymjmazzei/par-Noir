  "description": "par Noir Content Credentials: pN author assertion, Pen doc and rights assertions, manifest definitions, manifest summaries and the originality rule",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
