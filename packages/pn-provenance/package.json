    "@par-noir/public-names": "file:../public-names"
  },
  "peerDependencies": {
    "@contentauth/c2pa-web": "^0.17.0"
  },
  "peerDependenciesMeta": {
    "@contentauth/c2pa-web": { "optional": true }
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "vitest": "^3.2.4"
  },
  "license": "UNLICENSED",
